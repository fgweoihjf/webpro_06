<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>プログラミング言語</title>
</head>
<body>
  <h2>プログラミング言語の一覧</h2>
  <table>
    <tr><th>ID</th><th>言語名</th><th>登場年</th><th>開発者</th></tr>
      <% for( let row of data ) { %>
        <tr><td><%= row.id %></td>
        <td><%= row.name %></td>
        <td><%= row.year %></td>
        <td><%= row.creator %></td></tr>
      <% } %>
  </table>
</body>
</html>
